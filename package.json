{
  "name": "psani-vsemi-deseti",
  "productName": "Psaní všemi deseti",
  "version": "2.1.1",
  "description": "Výukový program pro psaní všemi deseti na české klávesnici",
  "main": "main.js",
  "author": "Psaní všemi deseti",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "cz.psanivsemideseti.app",
    "productName": "Psaní všemi deseti",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "app/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Psaní všemi deseti",
      "artifactName": "PsaniVsemiDeseti-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "PsaniVsemiDeseti-Portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "joshuaaaaa",
        "repo": "psani",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
